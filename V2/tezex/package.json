{
  "name": "Tezex",
  "version": "0.1.0",
  "homepage": "/",
  "private": true,
  "dependencies": {
    "@airgap/beacon-dapp": "^4.8.1",
    "@airgap/beacon-sdk": "^4.8.1",
    "@emotion/css": "^11.10.6",
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.0",
    "@mui/system": "^5.11.4",
    "@taquito/http-utils": "^24.3.0",
    "@taquito/rpc": "^24.3.0",
    "@taquito/taquito": "^24.3.0",
    "async-mutex": "^0.4.0",
    "bignumber.js": "^9.1.0",
    "immer": "^9.0.19",
    "lodash": "^4.18.1",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "use-immer": "^0.8.1",
    "usehooks-ts": "^2.9.1",
    "uuid": "^14.0.1",
    "web-vitals": "^3.0.4"
  },
  "author": {
    "name": "Cryptonomic Inc.",
    "email": "info@cryptonomic.tech"
  },
  "build": {
    "appId": "",
    "productName": "Tezex",
    "files": [
      "build/**/*",
      "package.json"
    ],
    "linux": {
      "target": "deb"
    },
    "extends": null
  },
  "scripts": {
    "predeploy": "npm run verify",
    "deploy": "gh-pages -d build --cname tezex.io",
    "start": "react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "test:ci": "npm test -- --watchAll=false --runInBand",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run audit:production && npm run typecheck && npm run test:ci && npm run build",
    "eject": "react-scripts eject",
    "prepare": "cd ../.. && husky install .husky/"
  },
  "lint-staged": {
    "*.{js,json,ts,tsx}": "eslint --cache --fix",
    "*.{js,json,ts,tsx,css,md}": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/css-mediaquery": "^0.1.2",
    "@types/jest": "^27.5.2",
    "@types/lodash": "^4.14.200",
    "@types/node": "^16.18.126",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "@types/ua-parser-js": "^0.7.37",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^8.35.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-react": "^7.32.2",
    "gh-pages": "^6.3.0",
    "https-browserify": "^1.0.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.2",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "prettier": "2.8.4",
    "process": "^0.11.10",
    "react-app-rewired": "^2.2.1",
    "react-scripts": "^5.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "typescript": "^4.9.5",
    "url": "^0.11.4",
    "vm-browserify": "^1.1.2"
  }
}
