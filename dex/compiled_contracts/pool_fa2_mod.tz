       nat
       { UNPAIR ;
         PUSH mutez 1 ;
         DUP 3 ;
         GET 3 ;
         EDIV ;
         IF_NONE { PUSH string "DIV by 0" ; FAILWITH } { CAR } ;
         DUP 3 ;
         CAR ;
         DUP ;
         INT ;
         EQ ;
         DUP 3 ;
         INT ;
         EQ ;
         DUP 5 ;
         INT ;
         EQ ;
         DUP 7 ;
         GET 9 ;
         DIG 7 ;
         GET 7 ;
         NOT ;
         OR ;
         OR ;
         OR ;
         OR ;
         IF { DROP 3 ; PUSH nat 0 }
            { PUSH nat 997 ;
              DUP 4 ;
              MUL ;
              PUSH nat 1000 ;
              DIG 2 ;
              MUL ;
              ADD ;
              SWAP ;
              PUSH nat 997 ;
              DIG 3 ;
              MUL ;
              MUL ;
              EDIV ;
              IF_NONE { PUSH string "DIV by 0" ; FAILWITH } { CAR } } } }

