                                                                                     IF_NONE { PUSH nat 12 ; FAILWITH } {} ;
                                                                                     PUSH mutez 0 ;
                                                                                     DIG 2 ;
                                                                                     DIG 3 ;
                                                                                     PAIR ;
                                                                                     TRANSFER_TOKENS ;
                                                                                     DIG 2 ;
                                                                                     NIL operation ;
                                                                                     DIG 2 ;
                                                                                     CONS ;
                                                                                     DIG 2 ;
                                                                                     CONS ;
                                                                                     PAIR } } } } } } } } } } } } } } } } } } } ;
  view "get_reserves"
       unit
       (pair nat nat)
       { CDR ;
         PUSH mutez 1 ;
         DUP 2 ;
         GET 3 ;
         EDIV ;
         SWAP ;
         CAR ;
         SWAP ;
         IF_NONE { PUSH string "DIV by 0" ; FAILWITH } { CAR } ;
         PAIR } ;
  view "get_lqt_total" unit nat { GET 7 } ;
  view "get_fee_bp"
       unit
       (pair nat (pair nat nat))
       { CDR ;
         DUP ;
         GET 17 ;
         PUSH nat 30 ;
         ADD ;
         SWAP ;
         GET 17 ;
         PUSH nat 30 ;
         PAIR 3 } ;
