# Address of the FA1.2 or FA2 token to be traded on the DEX.
TOKEN_ADDRESS=

# Native-pool RPC / TzKT overrides are optional. Token-to-token deployments
# require both explicitly so interrupted operation recovery never guesses an
# indexer. TzKT is also the fallback for FA2 ledger reads when an RPC cannot
# expose the expected big-map encoding.
TESTNET_RPC=
MAINNET_RPC=
PREVIEWNET_RPC=
TESTNET_TZKT_API=
MAINNET_TZKT_API=
PREVIEWNET_TZKT_API=

# Expected chain identifiers make test deployments fail closed if an RPC URL
# points at the wrong network. The token-to-token Mainnet workflow hardcodes
# the permanent Mainnet chain ID instead of accepting an environment override.
TESTNET_CHAIN_ID=
PREVIEWNET_CHAIN_ID=

# Tezos private key for the target network. Seed funds will be taken from this account.
# A network-specific remote signer can be used instead of an exported private
# key. Remote signing supports HSM-backed services such as Signatory.
TESTNET_PRIVATE_KEY=
MAINNET_PRIVATE_KEY=
PREVIEWNET_PRIVATE_KEY=
TESTNET_REMOTE_SIGNER_URL=
TESTNET_REMOTE_SIGNER_PKH=
MAINNET_REMOTE_SIGNER_URL=
MAINNET_REMOTE_SIGNER_PKH=
PREVIEWNET_REMOTE_SIGNER_URL=
PREVIEWNET_REMOTE_SIGNER_PKH=

# Exact base-10 integers only; decimal points and exponent notation are rejected.
# In MUTEZ. So for example, to seed 20 XTZ, set SEED_XTZ=20000000
SEED_XTZ=
# In TOKENS (with decimals). So for example, for a token with 6 decimals, to seed 10 tokens, set SEED_TOKEN=10000000
SEED_TOKEN=

# Final DEX manager. This may be an implicit account or a contract such as a
# multisig. The deployment signer temporarily manages the inactive setup, then
# modified-pool initialization proposes management here and leaves the pool
# paused until this address accepts. Base pools retain their one-step handoff.
# Initial LQT is minted here. Independent of PROTOCOL_FEE_RECIPIENT.
MANAGER=
# Required on Mainnet so the release manifest records the reviewed multisig
# policy. This is documented and reviewed; it is not compiled into the pool.
MANAGER_MULTISIG_THRESHOLD=

# Initial protocol fee claim recipient for mod pools. Required always; used at
# origination only when POOL_TYPE=mod. Must be a valid Tezos address (implicit
# or contract). Do not omit or default to MANAGER — set explicitly even when
# they happen to match. Previewnet may use distinct tz1s; Mainnet values are
# supplied out of band.
PROTOCOL_FEE_RECIPIENT=
PROTOCOL_FEE_RECIPIENT_MULTISIG_THRESHOLD=

# LQT metadata URIs (ipfs://<CID>). JSON templates live in scripts/metadata/;
# pinned CIDs are listed below and in deployments/lqt-metadata-notes.md.
# LQT is FA1.2: contract interfaces are ["TZIP-007"] only (do not claim
# TZIP-012). Token metadata uses JSON boolean shouldPreferSymbol: true
# (not the string "true").
#
# Contract metadata (METADATA_URI) — prefer the pair-specific file for each pool:
#   XTZ–USDt:  ipfs://bafkreiecvnqo4vapdiyukvzyaklveym3cvaqtdj6fzbnxnnvt4adekwgwe  # lqt-contract-xtz-usdt.json
#   XTZ–USDtz: ipfs://bafkreigfneq5eaxlmwyjahmsvm4cwxikdzshs55ujamnbzijdsgf42xfgu  # lqt-contract-xtz-usdtz.json
#   XTZ–BTCtz: ipfs://bafkreiaumi6epqmi7ldbnj5kedpmjvgw3nxj32fsxm6qiul7plcteszjbu  # lqt-contract-xtz-btctz.json
# Shared fallback: ipfs://bafkreifz6rirmj74nn5zw2cxg2avzbaq54pre7xaphbpixs3entycbe7li  # lqt-contract.json
#
# Token metadata (TOKEN_METADATA_URI):
#   XTZ–USDt:  ipfs://bafkreigxshv72rcp32i254zhgxqcmvfksoyr343csxmgdetsuqiae7g22a  # lqt-xtz-usdt.json
#   XTZ–USDtz: ipfs://bafkreiejiqvstfafwumwl4bcyit4pcwmgfdx7aths5dt5hgotm67m3v2tm  # lqt-xtz-usdtz.json
#   XTZ–BTCtz: ipfs://bafkreigm2kug4344rakvmjhbr7d5srxidasl72voe56stq7i5yvw5o7pci  # lqt-xtz-btctz.json
#
# Example (XTZ–USDt Previewnet redeploy):
METADATA_URI=ipfs://bafkreiecvnqo4vapdiyukvzyaklveym3cvaqtdj6fzbnxnnvt4adekwgwe
TOKEN_METADATA_URI=ipfs://bafkreigxshv72rcp32i254zhgxqcmvfksoyr343csxmgdetsuqiae7g22a

# The standard of the token. Can be either "FA1.2" or "FA2".
TOKEN_STANDARD=
# For FA2 tokens, the token ID to be traded on the DEX. For FA1.2 tokens, this value is ignored, so you can default to 0.
TOKEN_ID=
# The type of the DEX pool to be deployed. Can be either "mod" or "base". "mod" is a version modified with protocol fee, while "base" is a basic version without protocol fee.
POOL_TYPE=
# Modified pools use an immutable 30 bp total swap fee: 25 bp for LPs and
# 5 bp accumulated for PROTOCOL_FEE_RECIPIENT.

# Reviewed artifact and token-script pins. All three are mandatory for
# Mainnet and optional (but recommended) on test networks. The deployment
# manifest records the observed values in every environment.
DEX_ARTIFACT_SHA256=
LQT_ARTIFACT_SHA256=
TOKEN_CODE_SHA256=

# Mainnet release accountability for external token administrative changes.
# Values are recorded in the manifest and used by the incident runbook.
TOKEN_INTEGRATION_OWNER=
TOKEN_INCIDENT_CHANNEL=

# Confirmation depth and resumable operation-journal path. The state file is
# written atomically with mode 0600 and must not be deleted after a partial run.
CONFIRMATIONS=2
DEX_DEPLOYMENT_STATE=
# Test networks only. If set to 1, a dirty-tree rehearsal is permitted and the
# manifest records sourceDirty=true. Mainnet always refuses a dirty worktree.
ALLOW_DIRTY_DEPLOYMENT=0

# Token-to-token pool deployment (generic FA1.2/FA2 assets)
# Values are supplied at deployment time; no token, manager, recipient, or
# seed address is compiled into the pool artifact. Mainnet additionally
# requires a clean release tree, remote or local signer, both reviewed artifact
# hashes, exact token hashes, explicit LP receiver, originated multisig roles
# and thresholds, and the operational-accountability fields above.
TOKEN_A_STANDARD=
TOKEN_A_ADDRESS=
TOKEN_A_ID=0
# Canonical script-code SHA-256. Obtain it with:
# npm run inspect:token -- --rpc=<RPC> --address=<KT1>
# Review and pin the exact deployed token implementation before setting it.
TOKEN_A_CODE_SHA256=
TOKEN_B_STANDARD=
TOKEN_B_ADDRESS=
TOKEN_B_ID=0
TOKEN_B_CODE_SHA256=

# Atomic-unit seed quantities. Initial LQT supply is floor(sqrt(A * B)) and
# must exceed the permanent 1,000-unit lock.
SEED_AMOUNT_A=
SEED_AMOUNT_B=
# Optional on test networks; Mainnet requires this explicitly.
SEED_RECEIVER=

# The signer remains temporary manager through setup. This address is proposed
# after verification and must separately call %accept_manager.
FINAL_MANAGER=

# Immutable IPFS pointers for this deployment's pool and external FA1.2 LQT.
TOKEN_TOKEN_POOL_METADATA_URI=ipfs://
TOKEN_TOKEN_LQT_CONTRACT_METADATA_URI=ipfs://
TOKEN_TOKEN_LQT_TOKEN_METADATA_URI=ipfs://

# SHA-256 of dex/compiled_contracts/token_token_pool.tz. The deployer rejects
# any locally compiled artifact that does not match this reviewed digest.
TOKEN_TOKEN_ARTIFACT_SHA256=
# SHA-256 of dex/compiled_contracts/lqt.tz. Mandatory on Mainnet.
TOKEN_TOKEN_LQT_ARTIFACT_SHA256=

# Optional resumable receipt path; mode 0600 and ignored by git. Never contains
# the private key. Delete only when intentionally abandoning a deployment.
TOKEN_TOKEN_DEPLOYMENT_STATE=
